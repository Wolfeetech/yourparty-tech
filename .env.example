# YourParty.tech - Complete Environment Configuration
# Copy this file to .env and update all values

# ====================
# WordPress Database
# ====================
MYSQL_ROOT_PASSWORD=your_secure_root_password
WP_DB_NAME=yourparty
WP_DB_USER=yourparty
WP_DB_PASSWORD=your_secure_wordpress_password
WP_DEBUG=false

# ====================
# MongoDB (Mood/Ratings)
# ====================
MONGO_USER=admin
MONGO_PASSWORD=your_secure_mongo_password

# ====================
# AzuraCast Radio
# ====================
# Get API key from: AzuraCast Admin → Station → API Keys
AZURACAST_URL=http://your-azuracast-server
AZURACAST_API_KEY=your_azuracast_api_key

# ====================
# Music Directory
# ====================
# Path to your music library (read-only mount)
MUSIC_PATH=/path/to/your/music

# ====================
# SSL Certificates
# ====================
# For production, use Let's Encrypt via Certbot
SSL_CERT_PATH=./certs
SSL_KEY_PATH=./certs

# ====================
# Domain Configuration
# ====================
# Update nginx config and theme files with your domains:
# - api.yourparty.tech → your API domain
# - radio.yourparty.tech → your AzuraCast domain
# - yourparty.tech → your main site domain
